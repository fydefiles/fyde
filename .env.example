# Local defaults. Copy to .env; keep every real credential in a secret store.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000
EMAIL_ADAPTER=local
SCAN_ADAPTER=text_only
# Production: two different database roles/passwords. Company workers get only the second.
DATABASE_URL=
COMPANY_DATABASE_URL=
# Neon deployment: use neon for both providers and keep credentials server-side.
FILE_STORAGE=local
AUTH_PROVIDER=local
NEON_AUTH_BASE_URL=
NEON_STORAGE_BUCKET=uploads
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
# FYDE_ENV_FILE can select a private env file outside the checkout.
EMAIL_FROM=
RESEND_API_KEY=
EMAIL_UNIT_COST_USD=
EMAIL_DAILY_BUDGET_USD=0
EXTERNAL_EMAIL_DAILY_LIMIT=0
# Optional phone delivery. Use local only for an explicitly labeled development SMS outbox.
SMS_ADAPTER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=
# Conservative USD per SMS segment, including destination-specific carrier charges.
SMS_UNIT_COST_USD=
SMS_DAILY_BUDGET_USD=0
SMS_DAILY_LIMIT=0
CLAMAV_HOST=
CLAMAV_PORT=3310
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_UNLIMITED=
STRIPE_LIVE_ENABLED=0
SUBREDDIT_URL=
NAIVE_API_KEY=
NAIVE_AGENT_ID=
NAIVE_TASK_BUDGET_USD=0
COMPANY_DAILY_BUDGET_USD=0
COMPANY_PAUSED=0
COMPANY_DATA_MODE=fixture
COMPANY_RELEASE_ENABLED=0
COMPANY_VERIFIER_IMAGE=
COMPANY_SOURCE_ROOT=
RELEASE_GITHUB_REPOSITORY=mehmetuzgoren/fyde
RELEASE_GITHUB_TOKEN=
DEVELOPMENT_APP_URL=
INSTAGRAM_ENABLED=0
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=
INSTAGRAM_PERMISSIONS_APPROVED=0
INSTAGRAM_MAX_PER_DAY=1
CONTENT_PUBLIC_ORIGIN=
MARKETING_DESTINATION=http://127.0.0.1:8000
MARKETING_AUTORUN=0
OPERATOR_EMAIL=

# Exact browser-preview origins only. Native apps use bearer credentials.
# CUSTOMER_API_ORIGINS=http://localhost:8081,http://localhost:8082
