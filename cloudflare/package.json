{
  "name": "@fyde/cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "preview": "wrangler dev --port 8030",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir dist",
    "deploy:production": "wrangler deploy --env production",
    "check:production": "wrangler deploy --env production --dry-run --outdir dist/production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "typescript": "^6.0.0",
    "wrangler": "4.158.0"
  }
}
