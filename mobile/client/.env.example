# Public configuration only. Never put tokens, passwords or provider keys here.
# Simulator / local web development: http://127.0.0.1:8000
# Android emulator reaches the host at http://10.0.2.2:8000.
# Release and physical-device builds need the actual reachable HTTPS backend.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
